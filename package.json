{
    "name": "bitquran",
    "version": "1.2.3",
    "private": true,
    "description": "Aplikasi Qur'an Berbasis Web – Baca Al-Qur'an secara Daring",
    "keywords": [
        "al-quran",
        "alquran",
        "alquran-web",
        "quran",
        "quran-web"
    ],
    "homepage": "https://bitquran.net",
    "bugs": {
        "url": "https://github.com/rivaldys/bitquran/issues"
    },
    "license": "ISC",
    "author": "Ahmad Rivaldy S",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rivaldys/bitquran.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint && eslint src",
        "lint:fix": "oxlint --fix && eslint src --fix",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "prepare": "husky"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.101.4",
        "axios": "^1.19.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@typescript-eslint/parser": "^8.67.0",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/ui": "^4.1.11",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "eslint": "^10.9.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.3.0",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.79.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint",
            "eslint --no-warn-ignored",
            "oxfmt --check"
        ],
        "*.{css,json}": [
            "oxfmt --check"
        ]
    },
    "engines": {
        "node": ">=24"
    }
}
